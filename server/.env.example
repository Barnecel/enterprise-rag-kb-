# 复制为 server/.env 并填入实际值（.env 不应提交到版本库）

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3308
DB_USER=root
DB_PASSWORD=
DB_NAME=db_enterprise_9a

# ---- LLM (oMLX) ----
LLM_API_BASE=http://127.0.0.1:8000/v1
LLM_API_KEY=

# ---- 嵌入模型 ----
EMBEDDING_API_BASE=http://127.0.0.1:8000/v1

# ---- Flask / JWT ----
FLASK_SECRET_KEY=change-me-to-a-random-string
JWT_SECRET_KEY=change-me-to-a-random-string
FLASK_DEBUG=false

# HuggingFace国内镜像（重排器加载时在线校验会连huggingface.co无限挂起）
# 若需强制使用本地缓存可改: HF_HUB_OFFLINE=1
HF_ENDPOINT=https://hf-mirror.com
